{
  "ToggleSwitch": {
    "track": {
      "bgColor": {
        "value": "var(--base-color-scale-gray-0)",
        "dark": "var(--base-color-scale-gray-7)"
      },
      "borderColor": {
        "value": "var(--base-color-scale-gray-7)",
        "dark": "var(--base-color-scale-gray-2)"
      }
    },
    "icon": {
      "fgColor": {
        "value": "var(--base-color-scale-gray-7)",
        "dark": "var(--base-color-scale-gray-2)"
      }
    },
    "statusLabel": {
      "fgColor": {
        "rest": {
          "value": "var(--brand-color-text-default)",
          "dark": "var(--brand-color-text-default)"
        },
        "disabled": {
          "value": "var(--brand-color-text-muted)",
          "dark": "var(--brand-color-text-muted)"
        }
      }
    },
    "thumb": {
      "borderColor": {
        "value": "rgba(0, 0, 0, 0.08)",
        "dark": "rgba(0, 0, 0, 0.08)"
      },
      "on": {
        "bgColor": {
          "rest": {
            "value": "var(--base-color-scale-green-7)",
            "dark": "var(--base-color-scale-green-2)"
          },
          "hover": {
            "value": "var(--base-color-scale-green-8)",
            "dark": "var(--base-color-scale-green-1)"
          }
        }
      },
      "off": {
        "bgColor": {
          "rest": {
            "value": "var(--base-color-scale-gray-7)",
            "dark": "var(--base-color-scale-gray-2)"
          },
          "hover": {
            "value": "var(--base-color-scale-gray-8)",
            "dark": "var(--base-color-scale-gray-1)"
          }
        }
      },
      "disabled": {
        "bgColor": {
          "value": "var(--base-color-scale-gray-4)",
          "dark": "var(--base-color-scale-gray-5)"
        }
      }
    },
    "loading": {
      "fgColor": {
        "value": "var(--brand-color-text-muted)",
        "dark": "var(--brand-color-text-muted)"
      }
    }
  }
}
